# Production runtime inventory — after bootstrap, connect as the admin user
# Copy to hosts.yml and set ansible_host + key path. Prefer -e @profiles/prod.yml.
all:
  children:
    hardened_servers:
      hosts:
        prod-debian:
          ansible_host: 203.0.113.20
          ansible_user: admin
          ansible_port: 2222
          ansible_python_interpreter: /usr/bin/python3
          # ansible_ssh_private_key_file: ~/.ssh/id_ed25519
